@page "/pottery-journal"
@{
    ViewData["Title"] = "Pottery Journal";
    ViewData["ActiveNav"] = "PotteryJournal";
}

@section Styles {
  <link rel="stylesheet" href="~/css/pottery-journal.css" asp-append-version="true">
}

<header class="journal-header">
  <h1>Pottery Journal</h1>
  <div class="header-tools" id="headerTools">
    <span role="status"><span id="pieceCount">&hellip;</span> pieces on the shelf</span>
    <input id="searchInput" type="search" placeholder="Search title, clay, or glaze&hellip;" aria-label="Search pieces by title, clay, or glaze">
    <button type="button" class="filter-toggle" id="filterToggle" aria-expanded="false" aria-controls="filterBar">Filters</button>
  </div>
</header>

<div class="filter-bar" id="filterBar">
  <div class="filter-group" data-group="clay">
    <span class="filter-label">CLAY</span>
    <div class="chip-row" id="clayChips"></div>
  </div>
  <div class="filter-group" data-group="glaze">
    <span class="filter-label">GLAZE</span>
    <div class="chip-row" id="glazeChips"></div>
  </div>
</div>

<div id="galleryView" class="gallery"></div>

<div id="emptyState" class="empty-state hidden">
  <p id="emptyStateText">No pieces on the shelf yet.</p>
  <button id="clearFiltersBtn" class="hero-secondary-link hidden" type="button">Clear filters</button>
</div>
<p id="journalLoading" class="empty-state">Loading the journal&hellip;</p>
<p id="journalError" class="empty-state hidden">
  We couldn't load the journal right now.
  <button id="journalRetryBtn" class="hero-secondary-link" type="button">Try again</button>
</p>

<section id="detailView" class="detail-view hidden">
  <div class="detail-inner">
    <button id="backBtn" class="back-btn">&larr; back to the shelf</button>
    <article class="worksheet" id="worksheet"></article>
  </div>
</section>

@section Scripts {
  <script src="~/js/pottery-journal.js" asp-append-version="true"></script>
}
