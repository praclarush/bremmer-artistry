@page "/events"
@{
    ViewData["Title"] = "Events";
    ViewData["ActiveNav"] = "Events";
}

@section Styles {
  <link rel="stylesheet" href="~/css/events.css" asp-append-version="true">
}

<div class="section-heading">
  <h1>Events</h1>
</div>

<div class="events-toolbar hidden" id="eventsToolbar">
  <div class="view-toggle">
    <button type="button" id="listViewBtn" class="active">List</button>
    <button type="button" id="calendarViewBtn">Calendar</button>
  </div>
</div>

<div id="eventCards" class="event-cards"></div>
<div id="eventsEmptyState" class="events-empty hidden">
  <p>No upcoming events right now. Follow along on Instagram, or ask about the next show.</p>
  <ul class="events-empty-links">
    <li><a class="hero-secondary-link" href="https://www.instagram.com/bremmerArtistry" target="_blank" rel="noopener">Follow @@bremmerArtistry &rarr;</a></li>
    <li><a class="hero-secondary-link" href="/contact">Ask about the next show &rarr;</a></li>
    <li><a class="hero-secondary-link" href="/gallery">Browse the Gallery &rarr;</a></li>
  </ul>
</div>
<p id="eventsLoading" class="empty-state">Loading events&hellip;</p>
<p id="eventsError" class="empty-state hidden">
  We couldn't load events right now.
  <button id="eventsRetryBtn" class="hero-secondary-link" type="button">Try again</button>
</p>

<div id="calendarContainer" class="calendar hidden">
  <div class="calendar-nav">
    <button type="button" id="calendarPrev" aria-label="Previous month">&lsaquo;</button>
    <span class="calendar-month-label" id="calendarMonthLabel"></span>
    <button type="button" id="calendarNext" aria-label="Next month">&rsaquo;</button>
  </div>
  <div class="calendar-grid" id="calendarGrid"></div>
</div>

<div id="flyerLightbox" class="lightbox hidden" role="dialog" aria-modal="true" aria-label="Event flyer">
  <button id="flyerLightboxClose" class="lightbox-close" aria-label="Close">&times;</button>
  <figure class="lightbox-figure">
    <img id="flyerLightboxImage" alt="">
  </figure>
</div>

@section Scripts {
  <script src="~/js/events.js" asp-append-version="true"></script>
}
