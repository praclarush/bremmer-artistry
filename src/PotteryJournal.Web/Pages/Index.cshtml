@page "/"
@model PotteryJournal.Web.Pages.IndexModel
@using PotteryJournal.Infrastructure.Models
@{
    ViewData["Title"] = "Home";
    ViewData["ActiveNav"] = "Home";
}

@section Styles {
  <link rel="stylesheet" href="~/css/events.css" asp-append-version="true">
}

<div class="home-intro@(Model.FeaturedCollection is null ? " home-intro--solo" : string.Empty)">
  <section class="hero">
    <p class="hero-eyebrow">Handmade Pottery</p>
    <h1>Capturing a sense of <em>flow and intensity</em> within still forms.</h1>
    <p>
      Bremmer Artistry is a ceramic studio creating handmade pottery, from functional pieces like
      teapots, cups, and bowls to artistic forms.
    </p>
    <div class="hero-actions">
      <a class="btn" href="/events">See Upcoming Events</a>
      <a class="hero-secondary-link" href="/gallery">View Gallery &rarr;</a>
    </div>
  </section>

  @if (Model.FeaturedCollection is not null)
  {
    <section class="featured-collection" data-featured-collection aria-label="Featured collection: @Model.FeaturedCollection.CollectionName">
      <div class="featured-collection-stage">
        @for (int i = 0; i < Model.FeaturedCollection.Pieces.Count; i++)
        {
          FeaturedCollectionPieceModel piece = Model.FeaturedCollection.Pieces[i];
          <figure class="featured-collection-slide@(i == 0 ? " is-active" : string.Empty)" data-featured-slide>
            <img src="/uploads/pieces/@piece.ImageFileName" alt="@piece.Title" loading="eager">
          </figure>
        }
      </div>
      <div class="featured-collection-caption">
        <div>
          <p class="hero-eyebrow">Featured Collection</p>
          <h2>@Model.FeaturedCollection.CollectionName</h2>
        </div>
        @if (Model.FeaturedCollection.Pieces.Count > 1)
        {
          <p class="featured-collection-position" aria-hidden="true">
            <span data-featured-position>1</span> / @Model.FeaturedCollection.Pieces.Count
          </p>
        }
      </div>
      <a class="hero-secondary-link" href="/gallery#category/@Uri.EscapeDataString(Model.FeaturedCollection.CollectionName)">See the full @Model.FeaturedCollection.CollectionName &rarr;</a>
    </section>
  }
</div>

<section aria-labelledby="homeEventsHeading">
  <div class="section-heading">
    <h2 id="homeEventsHeading">Upcoming events</h2>
    <a href="/events">See all events &rarr;</a>
  </div>

  @if (Model.UpcomingEvents.Count == 0)
  {
    <div class="home-events-empty">
      <p class="empty-state">No events scheduled right now -- check back soon.</p>
      <a class="hero-secondary-link" href="/pottery-journal">Browse the Pottery Journal &rarr;</a>
    </div>
  }
  else
  {
    // Each link carries the occurrence key events.js gives its cards ("event-<id>-<start as Unix
    // milliseconds>"), so the Events page can scroll to that exact occurrence -- the id alone
    // repeats across every occurrence of a recurring event.
    EventModel nextEvent = Model.UpcomingEvents[0];
    bool nextEventHasPhoto = !string.IsNullOrEmpty(nextEvent.ImageFileName);
    <div class="home-events">
      <a class="event-feature@(nextEventHasPhoto ? string.Empty : " event-feature--no-photo")" href="/events#event-@(nextEvent.Id)-@(nextEvent.StartDateTime.ToUnixTimeMilliseconds())">
        @if (nextEventHasPhoto)
        {
          <div class="event-feature-photo">
            <img src="/uploads/events/@nextEvent.ImageFileName" alt="@nextEvent.Title" loading="lazy">
          </div>
        }
        <div class="event-feature-body">
          <span class="event-date">Next up &middot; @nextEvent.StartDateTime.ToString("dddd, MMMM d, yyyy")</span>
          <h3>@nextEvent.Title</h3>
          @if (!string.IsNullOrEmpty(nextEvent.VenueName))
          {
            <p class="event-venue">@nextEvent.VenueName</p>
          }
          <span class="event-feature-cta">Event details &rarr;</span>
        </div>
      </a>

      @if (Model.UpcomingEvents.Count > 1)
      {
        <ul class="event-ledger">
          @foreach (EventModel evt in Model.UpcomingEvents.Skip(1))
          {
            <li>
              <a class="event-ledger-row" href="/events#event-@(evt.Id)-@(evt.StartDateTime.ToUnixTimeMilliseconds())">
                <span class="event-date">@evt.StartDateTime.ToString("MMM d, yyyy")</span>
                <span class="event-ledger-title">@evt.Title</span>
                <span class="event-venue">@evt.VenueName</span>
                <span class="event-ledger-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          }
        </ul>
      }
    </div>
  }
</section>

<section class="statement" aria-labelledby="statementLabel">
  <p class="hero-eyebrow" id="statementLabel">The Work</p>
  <div>
    <p class="statement-text">
      The work is defined by ongoing experiments in shape, surface, and firing, often drawing
      inspiration from dynamic natural patterns like lightning and rivers.
    </p>
    <a class="hero-secondary-link" href="/pottery-journal">Read the Pottery Journal &rarr;</a>
  </div>
</section>

@if (Model.GalleryCategories.Count > 0)
{
  <section aria-labelledby="homeGalleryHeading">
    <div class="section-heading">
      <h2 id="homeGalleryHeading">From the gallery</h2>
      <a href="/gallery">View the full gallery &rarr;</a>
    </div>
    <div class="category-grid category-grid--teaser">
      @foreach (GalleryCategoryModel category in Model.GalleryCategories)
      {
        <a class="category-tile" href="/gallery#category/@Uri.EscapeDataString(category.Name)">
          <div class="category-photo">
            @if (!string.IsNullOrEmpty(category.CoverImageFileName))
            {
              <img src="/uploads/pieces/@category.CoverImageFileName" alt="" loading="lazy">
            }
          </div>
          <span class="category-name">@category.Name</span>
          <span class="category-count">@category.PieceCount @(category.PieceCount == 1 ? "piece" : "pieces")</span>
        </a>
      }
    </div>
  </section>
}

@section Scripts {
  <script src="~/js/featured-collection.js" asp-append-version="true"></script>
}
